<Window x:Class="PrintPricePro.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PrintPrice Pro" Height="760" Width="560"><ScrollViewer><StackPanel Margin="20"><TextBlock Text="PrintPrice Pro" FontSize="26" FontWeight="Bold" Margin="0,0,0,20"/><TextBlock Text="Filament Used (g)"/><TextBox Name="FilamentUsedBox" TextChanged="InputChanged"/><TextBlock Text="Spool Weight (g)" Margin="0,10,0,0"/><TextBox Name="SpoolWeightBox" Text="1000" TextChanged="InputChanged"/><TextBlock Text="Spool Price" Margin="0,10,0,0"/><TextBox Name="SpoolPriceBox" TextChanged="InputChanged"/><TextBlock Text="Hours" Margin="0,10,0,0"/><TextBox Name="HoursBox" TextChanged="InputChanged"/><TextBlock Text="Minutes" Margin="0,10,0,0"/><TextBox Name="MinutesBox" TextChanged="InputChanged"/><TextBlock Text="Machine Rate / Hour" Margin="0,10,0,0"/><TextBox Name="MachineRateBox" TextChanged="InputChanged"/><TextBlock Text="Design Fee" Margin="0,10,0,0"/><TextBox Name="DesignFeeBox" Text="0" TextChanged="InputChanged"/><TextBlock Text="Profit Margin (%)" Margin="0,10,0,0"/><TextBox Name="ProfitBox" Text="20" TextChanged="InputChanged"/><Separator Margin="0,20,0,20"/><TextBlock Name="MaterialCostText" FontSize="16"/><TextBlock Name="MachineCostText" FontSize="16"/><TextBlock Name="ProductionCostText" FontSize="16"/><TextBlock Name="SellingPriceText" FontSize="28" FontWeight="Bold"/></StackPanel></ScrollViewer></Window>