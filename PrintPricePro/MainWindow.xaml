<Window x:Class="PrintPricePro.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PrintPrice Pro" Height="780" Width="620">
<ScrollViewer><StackPanel Margin="20">
<TextBlock Text="PrintPrice Pro" FontSize="30" FontWeight="Bold"/>
<StackPanel Orientation="Horizontal" Margin="0,10,0,20">
<TextBlock Text="Currency:" VerticalAlignment="Center"/>
<ComboBox Name="CurrencyBox" Width="80" Margin="10,0,0,0" SelectionChanged="CurrencyChanged">
<ComboBoxItem Content="$"/>
<ComboBoxItem Content="€"/>
<ComboBoxItem Content="£"/>
</ComboBox>
</StackPanel>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0">
<TextBlock Text="Filament Used (g)"/><TextBox Name="FilamentUsedBox" TextChanged="InputChanged"/>
<TextBlock Text="Spool Weight (g)" Margin="0,8,0,0"/><TextBox Name="SpoolWeightBox" Text="1000" TextChanged="InputChanged"/>
<TextBlock Text="Spool Price" Margin="0,8,0,0"/><TextBox Name="SpoolPriceBox" TextChanged="InputChanged"/>
<TextBlock Text="Hours" Margin="0,8,0,0"/><TextBox Name="HoursBox" TextChanged="InputChanged"/>
<TextBlock Text="Minutes" Margin="0,8,0,0"/><TextBox Name="MinutesBox" TextChanged="InputChanged"/>
<TextBlock Text="Machine Rate / Hour" Margin="0,8,0,0"/><TextBox Name="MachineRateBox" TextChanged="InputChanged"/>
<TextBlock Text="Design Fee" Margin="0,8,0,0"/><TextBox Name="DesignFeeBox" Text="0" TextChanged="InputChanged"/>
<TextBlock Text="Profit Margin (%)" Margin="0,8,0,0"/><TextBox Name="ProfitBox" Text="20" TextChanged="InputChanged"/>
</StackPanel>
<Border Grid.Column="1" Margin="20,0,0,0" BorderThickness="1" Padding="12">
<StackPanel>
<TextBlock Name="MaterialCostText"/>
<TextBlock Name="MachineCostText"/>
<TextBlock Name="ProductionCostText"/>
<TextBlock Text="Selling Price" Margin="0,20,0,0" FontWeight="Bold"/>
<TextBlock Name="SellingPriceText" FontSize="34" FontWeight="Bold"/>
</StackPanel>
</Border>
</Grid>
</StackPanel></ScrollViewer></Window>