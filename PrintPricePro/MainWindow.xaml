<Window x:Class="PrintPricePro.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PrintPrice Pro" Height="780" Width="620" WindowStartupLocation="CenterScreen">
<ScrollViewer VerticalScrollBarVisibility="Auto">
<StackPanel Margin="20">
<TextBlock Text="PrintPrice Pro" FontSize="30" FontWeight="Bold"/>
<TextBlock Text="Professional 3D Print Pricing Calculator" Margin="0,0,0,20" Opacity="0.7"/>
<GroupBox Header="Inputs" Margin="0,0,0,15">
<StackPanel Margin="10">
<ContentPresenter/>
</StackPanel>
</GroupBox>
<GroupBox Header="Results">
<StackPanel Margin="10">
<TextBlock Text="Selling Price" FontWeight="Bold"/>
<TextBlock x:Name="SellingPriceText" FontSize="36" FontWeight="Bold"/>
</StackPanel>
</GroupBox>
</StackPanel>
</ScrollViewer>
</Window>