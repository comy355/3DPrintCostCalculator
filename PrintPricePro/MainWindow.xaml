<Window x:Class="PrintPricePro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintPrice Pro"
        Height="720"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="SpaceBetween">

            <TextBlock Text="PrintPrice Pro"
                       FontSize="28"
                       FontWeight="Bold"/>

        </StackPanel>

        <ScrollViewer Grid.Row="1">

            <StackPanel Margin="0,20,0,0">

                <TextBlock Text="Filament Used (g)"/>
                <TextBox x:Name="FilamentUsedBox"
                         Height="30"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Spool Weight (g)"/>
                <TextBox x:Name="SpoolWeightBox"
                         Height="30"
                         Text="1000"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Spool Price"/>
                <TextBox x:Name="SpoolPriceBox"
                         Height="30"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Print Hours"/>
                <TextBox x:Name="HoursBox"
                         Height="30"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Print Minutes"/>
                <TextBox x:Name="MinutesBox"
                         Height="30"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Machine Cost / Hour"/>
                <TextBox x:Name="MachineRateBox"
                         Height="30"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Design Fee"/>
                <TextBox x:Name="DesignFeeBox"
                         Height="30"
                         Text="0"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Profit Margin (%)"/>
                <TextBox x:Name="ProfitBox"
                         Height="30"
                         Text="20"
                         Margin="0,5,0,15"/>

                <Separator Margin="0,20"/>

                <TextBlock Text="Material Cost"
                           FontWeight="Bold"/>
                <TextBlock x:Name="MaterialCostText"
                           FontSize="20"
                           Margin="0,5,0,10"/>

                <TextBlock Text="Machine Cost"
                           FontWeight="Bold"/>
                <TextBlock x:Name="MachineCostText"
                           FontSize="20"
                           Margin="0,5,0,10"/>

                <TextBlock Text="Selling Price"
                           FontWeight="Bold"/>
                <TextBlock x:Name="SellingPriceText"
                           FontSize="26"
                           FontWeight="Bold"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>
