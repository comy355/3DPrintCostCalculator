<Window x:Class="PrintPricePro.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PrintPrice Pro" Height="760" Width="560"
 WindowStartupLocation="CenterScreen">
<Grid Margin="20">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
</Grid.RowDefinitions>

<TextBlock Text="PrintPrice Pro"
 FontSize="28"
 FontWeight="Bold"/>

<ScrollViewer Grid.Row="1" Margin="0,15,0,0">
<StackPanel>

<GroupBox Header="Material">
<StackPanel Margin="10">
<TextBlock Text="Filament Used (g)"/>
<TextBox x:Name="FilamentUsedBox"/>
<TextBlock Margin="0,10,0,0" Text="Spool Weight (g)"/>
<TextBox x:Name="SpoolWeightBox" Text="1000"/>
<TextBlock Margin="0,10,0,0" Text="Spool Price"/>
<TextBox x:Name="SpoolPriceBox"/>
</StackPanel>
</GroupBox>

<GroupBox Header="Print" Margin="0,15,0,0">
<StackPanel Margin="10">
<TextBlock Text="Hours"/>
<TextBox x:Name="HoursBox"/>
<TextBlock Margin="0,10,0,0" Text="Minutes"/>
<TextBox x:Name="MinutesBox"/>
<TextBlock Margin="0,10,0,0" Text="Machine Rate / Hour"/>
<TextBox x:Name="MachineRateBox"/>
</StackPanel>
</GroupBox>

<GroupBox Header="Extras" Margin="0,15,0,0">
<StackPanel Margin="10">
<TextBlock Text="Design Fee"/>
<TextBox x:Name="DesignFeeBox" Text="0"/>
<TextBlock Margin="0,10,0,0" Text="Profit Margin (%)"/>
<TextBox x:Name="ProfitBox" Text="20"/>
</StackPanel>
</GroupBox>

<Border Margin="0,20,0,0" Padding="15" BorderBrush="DarkGray" BorderThickness="1">
<StackPanel>
<TextBlock Text="Selling Price" FontSize="18" FontWeight="Bold"/>
<TextBlock x:Name="SellingPriceText" FontSize="34" FontWeight="Bold" Text="$0.00"/>
</StackPanel>
</Border>

</StackPanel>
</ScrollViewer>
</Grid>
</Window>